# =============================================================================
# Kronos Trader — environment variables (placeholders only; invariant 5)
# Copy to .env and fill in. NEVER commit real secrets, keys, or seed phrases.
# =============================================================================

# --- apps/web (Next.js, public vars are exposed to the browser) -------------
# WalletConnect Cloud project id: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id"
# Public app URL used for wallet connection metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default chain for Phase 1 wallet connect (testnet only during development)
NEXT_PUBLIC_DEFAULT_CHAIN="baseSepolia"
# Base URL of apps/api (used in later phases)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# --- apps/api (FastAPI) -----------------------------------------------------
DATABASE_URL="postgresql+psycopg://kronos:kronos@localhost:5432/kronos"
REDIS_URL="redis://localhost:6379/0"
# SIWE / session signing secret (generate a random value; do not reuse)
API_SECRET_KEY="change_me_to_a_long_random_string"
# Comma-separated CORS origins
CORS_ORIGINS="http://localhost:3000"

# --- apps/ml (Kronos service) ----------------------------------------------
ML_SERVICE_URL="http://localhost:8001"
# HuggingFace token if pulling gated checkpoints (optional)
HF_TOKEN=""

# --- Third-party APIs (testnet/dev only during development) -----------------
ONEINCH_API_KEY="your_1inch_api_key"
# Smart account / session keys provider (Biconomy or ZeroDev)
BICONOMY_API_KEY="your_biconomy_api_key"
ZERODEV_PROJECT_ID="your_zerodev_project_id"
